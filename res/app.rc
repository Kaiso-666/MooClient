#include <winver.h>

#include "resource.h"
#include "version.h"

IDI_APPICON ICON "app.ico"
IDR_SPLASH RCDATA "splash.png"
IDR_DOCVIEW RCDATA "changelog.js"
IDR_DOCVIEW_BG RCDATA "changelog-bg.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MOO_VERSION_COMMA
 PRODUCTVERSION MOO_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MooClient"
            VALUE "FileDescription", "MooClient - moomoo.io desktop client"
            VALUE "FileVersion", MOO_VERSION_STRING
            VALUE "InternalName", "MooClient"
            VALUE "OriginalFilename", "MooClient.exe"
            VALUE "ProductName", "MooClient"
            VALUE "ProductVersion", MOO_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
